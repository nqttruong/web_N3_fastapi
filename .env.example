# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=jlpt_ai_review
# Host port bound to 127.0.0.1 only (5433 avoids clashing with a system PostgreSQL on 5432)
POSTGRES_PORT=5433

# --- Backend (FastAPI) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jlpt:change-me-local-only@127.0.0.1:5433/jlpt_ai_review
# Separate database used by pytest (created automatically by the test suite)
TEST_DATABASE_URL=postgresql+psycopg://jlpt:change-me-local-only@127.0.0.1:5433/jlpt_ai_review_test
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated allowlist of browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
# Public: only the API base URL. Never put API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Import (PR2) ---
# IMPORT_STORAGE_DIR=/absolute/path/for/uploads   (default: backend/var/imports)
IMPORT_MAX_IMAGES=10
IMPORT_MAX_IMAGE_BYTES=10485760
IMPORT_RATE_LIMIT_PER_MINUTE=30
IMPORT_DRAFT_TTL_DAYS=14
# Optional Chrome Extension capture bearer token. Generate with: openssl rand -hex 32
# Leave empty to disable POST /api/v1/imports/browser-capture.
EXTENSION_IMPORT_TOKEN=
# Web Settings device management key; random 32+ characters, never put in NEXT_PUBLIC_*.
SYNC_ADMIN_KEY=

# --- Android learning content sync (read-only source repository) ---
# Defaults to the adjacent `app/N3 Sensei` checkout in this workspace. Override in deployment.
ANDROID_LEARNING_SOURCE_DIR=/media/truong/01DBB45ECE0C4E001/app/N3 Sensei
LEARNING_CONTENT_SYNC_INTERVAL_MINUTES=30
LEARNING_CONTENT_SYNC_MAX_RUN_SECONDS=300
# In production, set a random 32+ character secret for the Settings manual-check action.
LEARNING_CONTENT_SYNC_TOKEN=

# --- OCR (PR2) — local Tesseract with Japanese data (jpn). Set OCR_ENGINE=none to disable.
OCR_ENGINE=tesseract
OCR_TESSERACT_CMD=tesseract
OCR_LANGUAGES=jpn

# --- AI explanations (PR3) — backend only, never exposed to the browser ---
AI_PROVIDER=openai
# Leave empty to run without API calls (manual ChatGPT mode still works)
OPENAI_API_KEY=
# Any model that supports the Responses API + Structured Outputs
OPENAI_MODEL=gpt-6-astra
AI_REQUEST_TIMEOUT=90
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_REQUESTS_PER_DAY=200
# USD cap per calendar month (UTC); requires both prices below. 0 = no USD cap.
AI_MONTHLY_BUDGET_USD=0
# Current prices of OPENAI_MODEL per 1M tokens (check the provider's pricing page)
AI_PRICE_INPUT_PER_1M_TOKENS=
AI_PRICE_OUTPUT_PER_1M_TOKENS=
